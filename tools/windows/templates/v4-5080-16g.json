{
  "exe": "engine/strata.exe",
  "cwd": ".",
  "backend": "cuda",
  "gpu": 0,
  "lib_dirs": ["engine"],
  "tokenizer": "packs/v4-iq3kt/tokenizer",
  "model_name": "Qwen3.8-Flash-Next-Uncensored-v4-IQ3_KT",
  "aliases": ["strata", "qwen3.8-flash-next"],
  "host": "127.0.0.1",
  "port": 8080,
  "api_monitor": true,
  "open_browser": true,
  "log": "logs/strata-v4-engine.log",
  "expert_profile_save": "local/expert-profile.bin",
  "env": {"STRATA_STAGE_PIN": "0"},
  "args": [
    "--pack", "packs/v4-iq3kt",
    "--native", "__MODEL_FIRST_SHARD__",
    "--spec", "3",
    "--prefill", "1024",
    "--max-context", "65536",
    "--kv", "int8",
    "--kv-resident", "20480",
    "--expert-cache", "auto",
    "--expert-profile", "data/expert-profile.bin",
    "--resident-experts",
    "--vram-reserve-mib", "1024",
    "--prompt-cache", "6",
    "--pool-affinity", "auto",
    "--ple-io", "direct",
    "--check-logits",
    "--suffix-draft", "0",
    "--lookup-chain", "0"
  ]
}
